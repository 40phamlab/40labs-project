APP_ENV=staging
DATABASE_URL=postgres://api_runtime:REPLACE@staging-db.example/afya_core?sslmode=verify-full
DATABASE_MAX_CONNECTIONS=20
DATABASE_CONNECT_TIMEOUT_SECS=5
DATABASE_ACQUIRE_TIMEOUT_SECS=5
ADMIN_WEB_ORIGIN=https://staging-admin.example.com
SMS_MODE=live
OTP_PROVIDER=nextsms
NEXTSMS_API_TOKEN_FILE=/run/secrets/nextsms_api_token
NEXTSMS_SENDER_ID=40Labs-Staging
ACTIVATION_SIGNING_KEY_FILE=/run/secrets/activation_signing_key
TOTP_ENC_KEY_FILE=/run/secrets/admin_totp_enc_key
DEVICE_TOKEN_SIGNING_KEY_ID=v1
DEVICE_TOKEN_SIGNING_KEYS_FILE=/run/secrets/device_token_signing_keys
ADMIN_DEBUG_OTP=0
PORT=3000
